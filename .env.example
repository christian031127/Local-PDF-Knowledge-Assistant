# A PDF fájl elérési útja (abszolút vagy relatív útvonal)
PDF_PATH=./document.pdf

# Ollama beállítások
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
EMBEDDING_MODEL=nomic-embed-text

# Chunking beállítások
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ChromaDB perzisztens könyvtár
CHROMA_PERSIST_DIR=./chroma_db